{
    "name": "essential",
    "build": {
        "dockerfile": "../Dockerfile",
        "context": ".."
    },
    // Mount the project folder into the container
    "workspaceFolder": "/workspace",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",

    // Mount the data folder from local NVMe (mirrored from /ewsc by initializeCommand)
    "mounts": [
        "source=/data/pboyeau/data_essential,target=/workspace/data,type=bind,readonly"
    ],

    // Forward the Jupyter port
    "forwardPorts": [5937],

    // Run the container with GPU support
    "runArgs": [
        "--device=nvidia.com/gpu=all",
        "--env-file=${localWorkspaceFolder}/.env",
        // Bump /dev/shm from the 64MB default so PyTorch DataLoader workers (Boltz-2)
        "--shm-size=8g"
    ],

    // Runs on the host before the container is built/started.
    // Mirrors a whitelisted subset of /ewsc/pboyeau/data to /data/pboyeau/data_essential (local NVMe).
    // "initializeCommand": "bash ${localWorkspaceFolder}/.devcontainer/sync_data.sh",
    "postCreateCommand": "pip install -e . --no-deps",


    // Install useful extensions
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-toolsai.jupyter",
                "ms-python.black-formatter"
            ]
        }
    }
}
